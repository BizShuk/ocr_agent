{
  "name": "ocr_agent",
  "version": "0.0.0",
  "private": true,
  "description": "Vision-model OCR agent: classify document images and archive them per domain (general, medical)",
  "scripts": {
    "dev": "go run .",
    "test": "go test ./...",
    "build": "go build -o bin/ocr_agent .",
    "deploy": "go install .",
    "lint": "gofmt -l . && go vet ./...",
    "clean": "rm -rf bin",
    "run:setup": "bash scripts/run.sh",
    "run:process": "ocr_agent process --apply"
  }
}
